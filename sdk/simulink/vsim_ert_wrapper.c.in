/* vsim plugin wrapper for the Embedded Coder model @MODEL@.
 * Generated by vsim_export (sdk/simulink); rebuild rather than edit.
 *
 * The generated code is the code that runs on the car: @MODEL@_initialize,
 * @MODEL@_step (one call per sample time @STEP@ s) and the root I/O structs
 * @MODEL@_U / @MODEL@_Y. Its data are global, so one instance per process.
 */
#include <stddef.h>
#include <stdio.h>

#include "vsim_plugin.h"
#include "@MODEL@.h"

enum { VSIM_T_DOUBLE, VSIM_T_SINGLE, VSIM_T_INT8, VSIM_T_UINT8, VSIM_T_INT16, VSIM_T_UINT16, VSIM_T_INT32,
       VSIM_T_UINT32, VSIM_T_BOOLEAN };

typedef struct {
    VsimPort port;
    size_t offset;  /* in @MODEL@_U or @MODEL@_Y */
    int type;
} VsimWrapperPort;

/* Inputs, then outputs; the last entry of each list is a terminator. */
static const VsimWrapperPort vsim_inputs[] = {
@INPUTS@    {{NULL, NULL, VSIM_IN}, 0, 0}};
static const VsimWrapperPort vsim_outputs[] = {
@OUTPUTS@    {{NULL, NULL, VSIM_OUT}, 0, 0}};
#define VSIM_N_IN @N_IN@
#define VSIM_N_OUT @N_OUT@

static VsimPort vsim_ports[VSIM_N_IN + VSIM_N_OUT + 1];
static int vsim_instances = 0;

static void vsim_put(void *base, const VsimWrapperPort *p, double v) {
    char *at = (char *)base + p->offset;
    switch (p->type) {
    case VSIM_T_DOUBLE: *(real_T *)at = (real_T)v; break;
    case VSIM_T_SINGLE: *(real32_T *)at = (real32_T)v; break;
    case VSIM_T_INT8: *(int8_T *)at = (int8_T)(v < 0 ? v - 0.5 : v + 0.5); break;
    case VSIM_T_UINT8: *(uint8_T *)at = (uint8_T)(v < 0 ? 0 : v + 0.5); break;
    case VSIM_T_INT16: *(int16_T *)at = (int16_T)(v < 0 ? v - 0.5 : v + 0.5); break;
    case VSIM_T_UINT16: *(uint16_T *)at = (uint16_T)(v < 0 ? 0 : v + 0.5); break;
    case VSIM_T_INT32: *(int32_T *)at = (int32_T)(v < 0 ? v - 0.5 : v + 0.5); break;
    case VSIM_T_UINT32: *(uint32_T *)at = (uint32_T)(v < 0 ? 0 : v + 0.5); break;
    default: *(boolean_T *)at = (boolean_T)(v != 0.0); break;
    }
}

static double vsim_get(const void *base, const VsimWrapperPort *p) {
    const char *at = (const char *)base + p->offset;
    switch (p->type) {
    case VSIM_T_DOUBLE: return (double)*(const real_T *)at;
    case VSIM_T_SINGLE: return (double)*(const real32_T *)at;
    case VSIM_T_INT8: return (double)*(const int8_T *)at;
    case VSIM_T_UINT8: return (double)*(const uint8_T *)at;
    case VSIM_T_INT16: return (double)*(const int16_T *)at;
    case VSIM_T_UINT16: return (double)*(const uint16_T *)at;
    case VSIM_T_INT32: return (double)*(const int32_T *)at;
    case VSIM_T_UINT32: return (double)*(const uint32_T *)at;
    default: return *(const boolean_T *)at ? 1.0 : 0.0;
    }
}

static int vsim_describe(const VsimPort **ports, int *n) {
    int i;
    for (i = 0; i < VSIM_N_IN; ++i) vsim_ports[i] = vsim_inputs[i].port;
    for (i = 0; i < VSIM_N_OUT; ++i) vsim_ports[VSIM_N_IN + i] = vsim_outputs[i].port;
    *ports = vsim_ports;
    *n = VSIM_N_IN + VSIM_N_OUT;
    return 0;
}

static void *vsim_create(const char *params_json, double period, const VsimHost *host) {
    char message[160];
    (void)params_json;
    if (vsim_instances > 0) {
        host->log(host->context, VSIM_LOG_ERROR, "@MODEL@: generated code has global data; one instance per run");
        return NULL;
    }
    if (period < @STEP@ * (1.0 - 1e-9) || period > @STEP@ * (1.0 + 1e-9)) {
        snprintf(message, sizeof message, "@MODEL@ runs every %g s but the component period is %g s", @STEP@, period);
        host->log(host->context, VSIM_LOG_ERROR, message);
        return NULL;
    }
    ++vsim_instances;
    @MODEL@_initialize();
    return &vsim_instances;
}

static int vsim_step(void *self, double t, const double *in, double *out) {
    int i = 0;
    (void)self;
    (void)t;
#if VSIM_N_IN > 0
    for (i = 0; i < VSIM_N_IN; ++i) vsim_put(&@MODEL@_U, &vsim_inputs[i], in[i]);
#else
    (void)in;
#endif
    @MODEL@_step();
#if VSIM_N_OUT > 0
    for (i = 0; i < VSIM_N_OUT; ++i) out[i] = vsim_get(&@MODEL@_Y, &vsim_outputs[i]);
#else
    (void)out;
#endif
    return 0;
}

static void vsim_destroy(void *self) {
    (void)self;
    @MODEL@_terminate();
    vsim_instances = 0;
}

static const VsimPluginApi vsim_api = {VSIM_PLUGIN_ABI_VERSION, "@MODEL@", "@VERSION@", @STEP@,
                                       vsim_describe, vsim_create, vsim_step, vsim_destroy};

VSIM_PLUGIN_EXPORT const VsimPluginApi *vsim_plugin_entry(void) { return &vsim_api; }
